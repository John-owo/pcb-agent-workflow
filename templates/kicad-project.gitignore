# Copy to the KiCad project root and rename to .gitignore.

# KiCad automatic backups and temporary files
*-backups/
_autosave-*
\#auto_saved_files\#
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*-save.kicad_pcb
*-save.kicad_pro
*~
~*.lck
*.lck
*.tmp

# Personal UI state and caches, not part of the design
*.kicad_prl
fp-info-cache

# Export output; the fixed version handed to the factory is kept separately, see release-package.md
out/
